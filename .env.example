# Copy this file to .env (for local dev) to fill in creator links shown on
# the About and Developer pages. Both are optional — until set, those links
# simply don't render (no placeholder/dead link ever goes live).
#
# For the deployed GitHub Pages site, these must instead be set as
# repository-level Actions VARIABLES (not secrets — they're public URLs):
#   Settings -> Secrets and variables -> Actions -> Variables tab -> New repository variable
# .github/workflows/deploy.yml already passes them through to the build step,
# so setting them there is the only step needed to make them appear live.

VITE_PORTFOLIO_URL=
VITE_LINKEDIN_URL=
